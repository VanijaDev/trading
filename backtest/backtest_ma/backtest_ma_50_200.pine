//@version=6
indicator("MA Entry Circles", overlay = true, format = format.price, precision = 0, max_labels_count = 500, max_lines_count = 500)

// HOW TO USE: MA Entry Circles
// The script draws a circle at each saved price and time, with an optional short label.
// MA50 and MA200 are tags that sort your entries. The script draws no moving averages.
//
// 1. Paste this file into a new TradingView Pine indicator, save it, and add it to the chart.
//    Use a standard time-based chart of the market your entries belong to.
// 2. Add entries to the eight lists below, one list per strategy and timeframe.
//    In Settings > Draw entries, turn on the strategies and timeframes you want to see.
//    These filters don't change the chart's timeframe.
// 3. In Circle appearance, choose Circle size, Label size, and the shared Border and fill color.
//    Sizes are display presets, from Tiny to Huge.
//    In Price line, choose the line color, width, and candles on each side of the circle.
// 4. In Settings > Inputs > Tables, choose the table size and the background opacity.
//
// RECORD FORMAT: price; UNIX timestamp in milliseconds; u/d; short label; reason;
// The generator, tooltips, and table drop the fractional part of a price: 82655.585 shows as 82655.
// Rows you type by hand can include decimals. Use a dot and no thousands separators.
// A timestamp is an exact moment, independent of the chart's time zone.
// The table and tooltips show it in UTC.
// Direction u puts the label below the circle, and d puts it above. The circle stays on the price.
// The label can be empty. The reason is optional and starts on a new line under the label.
// Neither can contain semicolons. Write a line break as \n.
//
// EXAMPLE: add the quoted row inside the MA50_1D_ROWS list below. Don't declare the list again.
//
//     "_price_; _timestamp_; u/d; 💲_x\nBE: _x, Buffer: $_ / $_ / $0; Reason: ;",
//     Fields:
//       - price
//       - timestamp
//       - direction - up / down
//       - maximum reward reached in "x" before hitting SL or BE
//       - BE: "x" at the break-even move
//       - Buffer: SL buffer from this signal's recent bottom or high / max buffer drawdown (buffer only) / SL line price
//       - Reason: the chart shows the text after "Reason:" on a new line under the label. Leave it empty to hide it.
//     An SL line price above 0 draws a horizontal line at that price. The chart label hides
//     the SL line price and stays clear of the circle and the line. 0 means no line.
//
//     var array<string> MA50_1D_ROWS = array.from(
//         "94781; 1740960000000; d; 💲3x\nBE: 2x, Buffer: $500 / $350; Reason: ;",
//         ""
//     )
//
// Add each quoted row above the final empty string, followed by a comma.
// The script skips blank items. Edit a row to change an entry, or delete it to remove one.
// Save and update the script on the chart after editing. The lists start empty.
//
// PICK A POINT TO GENERATE A RECORD:
// 1. In Settings, turn on Generate a record. Enter BE and the SL buffer, or leave them empty to keep _.
// 2. Use the indicator's More > Reset points and pick a price and time on the chart,
//    or drag the existing point. Chart clicks don't create records.
// 3. Open Pine Logs and copy the record line below 👇.
// 4. Replace u/d with u or d. Fill in the label template, or delete it to leave the label empty.
//    Type the reason after Reason:, or leave it empty to hide it.
// 5. Wrap the record in quotes, add a comma, and paste it into the matching list
//    as in the example. Save and update. Picking a point doesn't save an entry.
// Reset points selects a new point. It doesn't delete saved entries.
// Turn generation off when you finish. Deselect the indicator to hide its input handle.
//
// CHECK AND KEEP YOUR ENTRIES:
// The bottom-right table shows saved, matching, drawn, invalid, and omitted counts.
// For an invalid row with a usable price and time, the script draws a red circle labeled !!! ERROR !!!.
// Hover over it to see the source item and the error. Fix the row and update.
// The script can't place a row with a bad price or time. Check the table's Diagnostics.
// If a circle is missing, check the filters, the loaded chart history, and Diagnostics.
// The lists have no symbol field. Keep a separate copy of the script for each market.
// The entry lists live in the Pine source, outside Settings. Keep a local backup.

// ENTRY LISTS: keep your entries in these eight lists.

var array<string> MA50_1D_ROWS = array.from(
// SL:
// BE:
    ""
)
var array<string> MA50_4H_ROWS = array.from(
// SL:
// BE:
    ""
)
var array<string> MA50_1H_ROWS = array.from(
// SL:
// BE:
    ""
)
var array<string> MA50_15M_ROWS = array.from(
// SL:
// BE:
    ""
)
var array<string> MA200_1D_ROWS = array.from(
// SL:
// BE:
    ""
)
var array<string> MA200_4H_ROWS = array.from(
// SL:
// BE:
    ""
)
var array<string> MA200_1H_ROWS = array.from(
// SL:
// BE:
    ""
)
var array<string> MA200_15M_ROWS = array.from(
// SL:
// BE:
    ""
)

// SETTINGS
const string FILTERS_GROUP = "Draw entries"
const string STYLE_GROUP = "Circle appearance"
const string TABLES_GROUP = "Tables"
const string GENERATOR_GROUP = "Record generator"
const string LINES_GROUP = "Price line"
const string DIRECTION_PLACEHOLDER = "u/d"
// The parser reads the Buffer values after BUFFER_KEY.
const string BUFFER_KEY = "Buffer:"
// The generator fills BE and the SL buffer from Settings. A label that, without its
// SL line price, starts with LABEL_HEAD and ends with LABEL_TAIL keeps the reward and
// max buffer drawdown placeholders, so the parser treats it as an unfilled template.
const string LABEL_HEAD = "💲_x\nBE: "
const string LABEL_MIDDLE = "x, " + BUFFER_KEY + " $"
const string LABEL_TAIL = " / $_"
// The generator writes 0 for the SL line price: no line until you enter one.
const string LABEL_LINE = " / $0"
// The generator writes REASON_PREFIX, and you type the reason after it. The chart
// hides the prefix, so an unfilled one shows nothing.
const string REASON_PREFIX = "Reason:"
// 9999-12-31 23:59:59.999 UTC in milliseconds, the latest time a record can hold.
const int MAX_TIMESTAMP = 253402300799999
const int MAX_LABELS = 500
const int MAX_BARS = 100000
const int MAX_ISSUES = 20

// @enum Size presets for circles and labels. Field titles appear in the dropdowns.
enum SizePreset
    tiny = "Tiny"
    small = "Small"
    normal = "Normal"
    large = "Large"
    xLarge = "X-Large"
    huge = "Huge"

// @enum Size presets for the statistics table. Field titles appear in the dropdown.
enum TableSize
    tiny = "Tiny"
    small = "Small"
    normal = "Normal"
    large = "Large"
    huge = "Huge"

bool showMa50Input = input.bool(true, "MA50", inline = "strategy", group = FILTERS_GROUP)
bool showMa200Input = input.bool(true, "MA200", inline = "strategy", group = FILTERS_GROUP)
bool showDayInput = input.bool(true, "1D", inline = "timeframe", group = FILTERS_GROUP)
bool show4hInput = input.bool(true, "4h", inline = "timeframe", group = FILTERS_GROUP)
bool show1hInput = input.bool(true, "1h", inline = "timeframe", group = FILTERS_GROUP)
bool show15mInput = input.bool(true, "15m", inline = "timeframe", group = FILTERS_GROUP, tooltip = "Choose which saved categories to draw. The chart timeframe stays the same.")

SizePreset circleSizeInput = input.enum(SizePreset.small, "Circle size", group = STYLE_GROUP, tooltip = "Display presets, from Tiny to Huge.")
SizePreset labelSizeInput = input.enum(SizePreset.normal, "Label size", group = STYLE_GROUP, tooltip = "Text size of each circle's label, from Tiny to Huge.")
// Default: black at 25% opacity (transparency 75).
color circleColorInput = input.color(color.new(color.black, 75), "Border and fill color", group = STYLE_GROUP, tooltip = "One color for all valid entries in both strategies and all timeframes. Invalid entries are red.")

TableSize tableSizeInput = input.enum(TableSize.small, "Table size", group = TABLES_GROUP, tooltip = "Sets the text and cell size of the statistics table. To hide the table, use the Style > Tables checkbox.")
int tableOpacityInput = input.int(90, "Background opacity, %", minval = 0, maxval = 100, step = 5, group = TABLES_GROUP, tooltip = "The table background uses the chart background color. 100 is solid, 0 is clear.")

bool generateEntryInput = input.bool(false, "Generate a record", group = GENERATOR_GROUP, tooltip = "Turn on, then pick a point with More > Reset points or drag the existing point. Copy the record from Pine Logs, fill in the direction, label, and reason, and add it to a list. Chart clicks don't create records.")
float pickedPriceInput = input.price(0.0, "Price", inline = "point", group = GENERATOR_GROUP, confirm = true)
int pickedTimeInput = input.time(0, "Time", inline = "point", group = GENERATOR_GROUP, confirm = true, tooltip = "Price and Time share one picker. TradingView may ask for a point when you add the indicator, with generation on or off. Reset points picks a new point and keeps your lists.")
string slBufferInput = input.string("", "SL buffer, $", group = GENERATOR_GROUP, tooltip = "SL buffer from this signal's recent bottom or high, without the $ sign. The generator writes it into the label. Leave it empty to write _.")
string beLevelInput = input.string("", "BE, x", group = GENERATOR_GROUP, tooltip = "Profit in x when you moved the SL to break-even, without the x. The generator writes it into the label. Leave it empty to write _.")

color lineColorInput = input.color(color.red, "Line color", group = LINES_GROUP)
int lineWidthInput = input.int(3, "Line width", minval = 1, group = LINES_GROUP, tooltip = "In pixels.")
int lineCandlesInput = input.int(5, "Candles each side", minval = 1, group = LINES_GROUP, tooltip = "The line runs from this many candles left of the circle's candle to this many right of it.")

type EntryPoint
    float price
    int timestamp
    string direction
    string shortLabel
    string problem = ""
    float linePrice = 0.0
    string reason = ""

type EntryGroup
    string strategy
    string sourceTimeframe
    array<EntryPoint> entries
    array<EntryPoint> errors
    int invalidCount

type EntryDrawing
    EntryPoint ep
    EntryGroup group
    int barPosition

var array<EntryGroup> groups = array.new<EntryGroup>()
var array<string> issues = array.new<string>()
var array<int> barOpenTimes = array.new<int>()
var array<int> barCloseTimes = array.new<int>()
var array<label> circles = array.new<label>()
var array<label> captions = array.new<label>()
var array<line> priceLines = array.new<line>()
// force_overlay keeps the table, labels, and lines on the price chart when an older
// instance of the script runs in its own pane.
var table stats = table.new(position.bottom_right, 2, 10, border_width = 1, force_overlay = true)

// @function Prepares a Settings value for the label template.
// @param value Text from a Settings input.
// @returns The trimmed value, or _ when it's empty.
valueOrPlaceholder(string value) =>
    string trimmed = str.trim(value)
    trimmed == "" ? "_" : trimmed

// @function Formats a price without its fractional part.
// @param value Price to format.
// @returns The price truncated toward zero, as a string.
formatPrice(float value) =>
    // int() truncates. A format string would round the value.
    str.tostring(int(value))

// @function Formats a UNIX time as a UTC date and time.
// @param value UNIX time in milliseconds.
// @returns The time as yyyy-MM-dd HH:mm:ss, in UTC.
formatUtcTime(int value) =>
    str.format_time(value, "yyyy-MM-dd HH:mm:ss", "UTC")

// @function Splits off the first semicolon-delimited field. Text without a semicolon
//           becomes one whole field, so an incomplete row keeps its usable price
//           and time. parseRecord() reports the missing fields.
// @param value Text to split.
// @returns A tuple: the trimmed field, the text after the semicolon, and whether
//          the text contains a semicolon.
takeField(string value) =>
    int separator = str.pos(value, ";")
    bool found = not na(separator) and separator >= 0
    string field = found ? str.trim(str.substring(value, 0, separator)) : str.trim(value)
    string rest = found and separator + 1 < str.length(value) ? str.substring(value, separator + 1) : ""
    [field, rest, found]

// @function Splits the SL line price off a label: the third value after BUFFER_KEY.
// @param labelText Label text from a record.
// @returns A tuple: the label without the line price, and the line price. The price
//          is 0 when the label has no third value or the value is _ or empty, and
//          na when the value isn't a number.
splitLinePrice(string labelText) =>
    string shown = labelText
    float linePrice = 0.0
    int keyPos = str.pos(labelText, BUFFER_KEY)
    if not na(keyPos) and keyPos >= 0
        int valuesStart = keyPos + str.length(BUFFER_KEY)
        string valuesText = valuesStart < str.length(labelText) ? str.substring(labelText, valuesStart) : ""
        array<string> values = str.split(valuesText, "/")
        if array.size(values) >= 3
            shown := str.trim(str.substring(labelText, 0, valuesStart) + array.get(values, 0) + "/" + array.get(values, 1))
            string priceText = str.trim(str.replace_all(array.get(values, 2), "$", ""))
            linePrice := priceText == "" or priceText == "_" ? 0.0 : str.tonumber(priceText)
    [shown, linePrice]

// @function Parses one record: price; timestamp; u/d; label; reason; The reason is optional.
// @param raw Record text from a source list.
// @returns A tuple: the entry, or na when its price or time is unusable, and the
//          problem text, empty for a valid record.
parseRecord(string raw) =>
    string row = str.trim(raw)
    [priceText, afterPrice, hasPrice] = takeField(row)
    [timeText, afterTime, hasTime] = takeField(afterPrice)
    [directionText, afterDirection, hasDirection] = takeField(afterTime)
    [labelField, afterLabel, hasLabel] = takeField(afterDirection)
    // The reason follows the label's semicolon. A semicolon after the reason is optional.
    string reasonText = hasLabel ? str.trim(afterLabel) : ""
    if str.endswith(reasonText, ";")
        reasonText := str.trim(str.substring(reasonText, 0, str.length(reasonText) - 1))
    // Deleting the label template with its semicolon leaves the reason in the label field.
    bool labelIsReason = reasonText == "" and str.startswith(labelField, REASON_PREFIX)
    string labelText = labelIsReason ? "" : labelField
    if labelIsReason
        reasonText := labelField
    // The chart shows the reason without the generator's Reason: prefix.
    if str.startswith(reasonText, REASON_PREFIX)
        int prefixEnd = str.length(REASON_PREFIX)
        reasonText := prefixEnd < str.length(reasonText) ? str.trim(str.substring(reasonText, prefixEnd)) : ""
    [shownLabel, linePrice] = splitLinePrice(labelText)
    float priceNumber = str.tonumber(priceText)
    float timeNumber = str.tonumber(timeText)
    bool validPrice = not na(priceNumber) and not str.contains(priceText, ",") and not str.contains(priceText, "\n")
    bool validTime = not na(timeNumber) and not str.contains(timeText, "\n") and timeNumber >= 0 and timeNumber <= MAX_TIMESTAMP and timeNumber == math.floor(timeNumber)
    string direction = str.lower(directionText)
    direction := direction == "up" ? "u" : direction == "down" ? "d" : direction
    // The direction check, not the line-break check, reports a direction field that
    // runs into the label, as with "u," instead of "u;".
    string problem = ""
    if not hasPrice or not hasTime or not hasDirection
        problem := "Use the format: price; timestamp; u/d; label;"
    else if str.contains(priceText + timeText, "\n")
        problem := "Only the label and the reason can contain line breaks."
    else if not validPrice
        problem := "Invalid price. Use a decimal point and no thousands separators."
    else if not validTime
        problem := "Use a whole UNIX timestamp in milliseconds, years 1970 to 9999."
    else if direction != "u" and direction != "d"
        problem := "Set the direction to u or d. Replace the " + DIRECTION_PLACEHOLDER + " placeholder."
    else if str.contains(reasonText, ";")
        problem := "Too many fields. The label and the reason can't contain semicolons."
    else if na(linePrice) or linePrice < 0
        problem := "Invalid SL line price. Use a positive number, or 0 for no line."
    else if str.startswith(shownLabel, LABEL_HEAD) and str.endswith(shownLabel, LABEL_TAIL)
        problem := "Fill in the label placeholder, or leave the label empty."
    EntryPoint ep = na
    // A row with a bad direction or label keeps its chart location when its price
    // and time are usable. addGroup() puts it in the error list.
    if validPrice and validTime
        ep := EntryPoint.new(priceNumber, int(timeNumber), direction, shownLabel, problem, nz(linePrice), reasonText)
    [ep, problem]

// @function Parses one source list and adds it to `groups` as an entry group.
//           Adds the first MAX_ISSUES problems to `issues`.
// @param rows Source list of records.
// @param strategy Strategy tag: MA50 or MA200.
// @param sourceTimeframe Timeframe tag: 1D, 4h, 1h, or 15m.
// @returns 0.
addGroup(array<string> rows, string strategy, string sourceTimeframe) =>
    array<EntryPoint> entries = array.new<EntryPoint>()
    array<EntryPoint> errors = array.new<EntryPoint>()
    int invalid = 0
    for [rowIndex, raw] in rows
        if str.trim(raw) != ""
            [ep, problem] = parseRecord(raw)
            if problem == ""
                array.push(entries, ep)
            else
                invalid += 1
                string diagnostic = strategy + " / " + sourceTimeframe + " / item " + str.tostring(rowIndex + 1) + ": " + problem
                if not na(ep)
                    ep.problem := diagnostic
                    array.push(errors, ep)
                if array.size(issues) < MAX_ISSUES
                    array.push(issues, diagnostic)
    array.push(groups, EntryGroup.new(strategy, sourceTimeframe, entries, errors, invalid))
    0

// @function Checks a group against the strategy and timeframe filters.
// @param group Entry group to check.
// @returns true when the inputs show both the group's strategy and its timeframe.
isAllowed(EntryGroup group) =>
    bool strategyAllowed = group.strategy == "MA50" ? showMa50Input : showMa200Input
    bool timeframeAllowed = switch group.sourceTimeframe
        "1D" => showDayInput
        "4h" => show4hInput
        "1h" => show1hInput
        "15m" => show15mInput
        => false
    strategyAllowed and timeframeAllowed

// @function Converts the Circle size input to a label size.
// @returns Label size in typographic points. size.huge equals 24, so numeric
//          sizes allow larger circles than the size.* constants.
circleSizePoints() =>
    switch circleSizeInput
        SizePreset.tiny => 24
        SizePreset.small => 36
        SizePreset.normal => 48
        SizePreset.large => 60
        SizePreset.xLarge => 66
        SizePreset.huge => 72

// @function Converts the Label size input to a text size. Tiny, Small, Normal,
//           Large, and Huge match size.tiny (~7), size.small (~10), size.normal (12),
//           size.large (18), and size.huge (24). X-Large (21) sits between Large and Huge.
// @returns Text size for the caption label, as an int.
labelTextSize() =>
    switch labelSizeInput
        SizePreset.tiny => 7
        SizePreset.small => 10
        SizePreset.normal => 12
        SizePreset.large => 18
        SizePreset.xLarge => 21
        SizePreset.huge => 24

// @function Converts the Table size input to a text size.
// @returns A size.* constant for the table text.
tableTextSize() =>
    switch tableSizeInput
        TableSize.tiny => size.tiny
        TableSize.small => size.small
        TableSize.normal => size.normal
        TableSize.large => size.large
        TableSize.huge => size.huge

// @function Finds the loaded candle that contains a timestamp. A timestamp in an
//           overnight, weekend, or session gap matches no candle, so its circle
//           can't land on a candle on the other side of the gap.
// @param timestampValue UNIX time in milliseconds.
// @returns Index into `barOpenTimes` and `barCloseTimes`, or -1 when no loaded candle
//          contains the timestamp.
barPositionAt(int timestampValue) =>
    int lo = 0
    int hi = array.size(barOpenTimes) - 1
    int found = -1
    while lo <= hi
        int middle = int(math.floor((lo + hi) / 2.0))
        if array.get(barOpenTimes, middle) <= timestampValue
            found := middle
            lo := middle + 1
        else
            hi := middle - 1
    if found >= 0
        int closing = array.get(barCloseTimes, found)
        if na(closing) or timestampValue >= closing
            found := -1
    found

// @function Deletes the labels and lines in `circles`, `captions`, and `priceLines`,
//           and empties those arrays.
// @returns 0.
clearDrawings() =>
    while array.size(circles) > 0
        label.delete(array.pop(circles))
    while array.size(captions) > 0
        label.delete(array.pop(captions))
    while array.size(priceLines) > 0
        line.delete(array.pop(priceLines))
    0

// @function Builds the caption shown next to an entry's circle.
// @param ep Entry to describe.
// @returns !!! ERROR !!! for an error. Otherwise the label, with the reason on a new
//          line under it. Empty when the entry has neither.
entryCaption(EntryPoint ep) =>
    ep.problem != "" ? "!!! ERROR !!!" : ep.shortLabel == "" or ep.reason == "" ? ep.shortLabel + ep.reason : ep.shortLabel + "\n" + ep.reason

// @function Draws one entry: a circle at its price on its candle, plus a caption
//           when the entry has text to show. Adds the drawings to `circles`,
//           `captions`, and `priceLines`. Reads `barOpenTimes` and the Circle
//           appearance and Price line inputs.
// @param drawing Entry to draw, with its group and candle. The function draws an
//        entry with a non-empty `problem` as an error.
// @returns 0.
drawEntry(EntryDrawing drawing) =>
    EntryPoint ep = drawing.ep
    bool isError = ep.problem != ""
    color markerColor = isError ? color.new(color.red, 50) : circleColorInput
    string caption = entryCaption(ep)
    string heading = isError ? ep.problem : drawing.group.strategy + " · " + drawing.group.sourceTimeframe + " · " + str.upper(ep.direction)
    string details = heading + "\nPrice: " + formatPrice(ep.price) + "\n" + formatUtcTime(ep.timestamp) + " UTC" + (isError or ep.shortLabel == "" ? "" : "\nLabel: " + ep.shortLabel) + (isError or ep.reason == "" ? "" : "\n" + ep.reason)
    // The circle and its caption sit on the open time of the candle that holds the
    // record's time, the same x the price line centers on. The tooltip keeps the exact time.
    int candleTime = array.get(barOpenTimes, drawing.barPosition)
    // The circle label has no text, so it stays round. Its center sits on the
    // recorded price, with no offset.
    array.push(circles, label.new(candleTime, ep.price, "", xloc = xloc.bar_time, yloc = yloc.price, color = markerColor, style = label.style_circle, size = circleSizePoints(), tooltip = details, force_overlay = true))
    bool hasLine = not isError and ep.linePrice > 0
    if hasLine
        // The line stops at the first or last loaded candle.
        int leftTime = array.get(barOpenTimes, math.max(drawing.barPosition - lineCandlesInput, 0))
        int rightTime = array.get(barOpenTimes, math.min(drawing.barPosition + lineCandlesInput, array.size(barOpenTimes) - 1))
        array.push(priceLines, line.new(leftTime, ep.linePrice, rightTime, ep.linePrice, xloc = xloc.bar_time, color = lineColorInput, width = lineWidthInput, force_overlay = true))
    if caption != ""
        // Errors show their warning above the circle, because their direction may be invalid.
        bool isUp = not isError and ep.direction == "u"
        // A line past the entry on the caption's side (below it for u, above it for d)
        // becomes the caption's anchor, so the caption clears both the circle and the line.
        bool atLine = hasLine and (isUp ? ep.linePrice < ep.price : ep.linePrice > ep.price)
        // The caption sits in its own label with a transparent background, so its
        // text can't stretch or cover the circle. Blank text lines pad the caption
        // away from the circle without moving the anchor. Larger text makes taller
        // lines, so the line count scales by 10 / text size. With Small text (10),
        // a Tiny circle (24) gets 3 lines of padding, and larger circles get more.
        int paddingLines = int(math.ceil(circleSizePoints() * 10 / (8.0 * labelTextSize())))
        string padding = str.repeat("\n", paddingLines)
        string captionText = isUp ? padding + caption : caption + padding
        array.push(captions, label.new(candleTime, atLine ? ep.linePrice : ep.price, captionText, xloc = xloc.bar_time, yloc = yloc.price, color = color.new(markerColor, 100), style = isUp ? label.style_label_up : label.style_label_down, textcolor = isError ? color.red : chart.fg_color, size = labelTextSize(), tooltip = details, force_overlay = true))
    0

// @function Joins the valid entry counts of four consecutive groups.
// @param start Index of the first group in `groups`: 0 for MA50, 4 for MA200.
// @returns The 1D / 4h / 1h / 15m counts, separated by " / ".
categoryCounts(int start) =>
    string result = ""
    for i = start to start + 3
        EntryGroup group = array.get(groups, i)
        result += (i == start ? "" : " / ") + str.tostring(array.size(group.entries))
    result

// @function Writes one row of the `stats` table, with the text size and background
//           opacity from the Tables inputs.
// @param row Table row index.
// @param title Text for the left cell.
// @param value Text for the right cell.
// @param ink Text color for the right cell.
// @param tip Tooltip for the right cell.
// @returns 0.
setTableRow(int row, string title, string value, color ink, string tip = "") =>
    color cellColor = color.new(chart.bg_color, 100 - tableOpacityInput)
    string textSize = tableTextSize()
    table.cell(stats, 0, row, title, text_color = chart.fg_color, bgcolor = cellColor, text_size = textSize, text_halign = text.align_left)
    table.cell(stats, 1, row, value, text_color = ink, bgcolor = cellColor, text_size = textSize, text_halign = text.align_left, tooltip = tip)
    0

// Build all eight entry groups once, including hidden categories.
if barstate.isfirst
    addGroup(MA50_1D_ROWS, "MA50", "1D")
    addGroup(MA50_4H_ROWS, "MA50", "4h")
    addGroup(MA50_1H_ROWS, "MA50", "1h")
    addGroup(MA50_15M_ROWS, "MA50", "15m")
    addGroup(MA200_1D_ROWS, "MA200", "1D")
    addGroup(MA200_4H_ROWS, "MA200", "4h")
    addGroup(MA200_1H_ROWS, "MA200", "1h")
    addGroup(MA200_15M_ROWS, "MA200", "15m")

bool supportedChart = chart.is_standard and not timeframe.isticks and not na(time_close)
if supportedChart
    int lastIndex = array.size(barOpenTimes) - 1
    if lastIndex < 0 or array.get(barOpenTimes, lastIndex) != time
        if array.size(barOpenTimes) >= MAX_BARS
            array.shift(barOpenTimes)
            array.shift(barCloseTimes)
        array.push(barOpenTimes, time)
        array.push(barCloseTimes, time_close)
    else
        array.set(barCloseTimes, lastIndex, time_close)

// varip stops realtime ticks from logging the record again. Changing the picker or
// any input reloads the script, rebuilds the log history, and resets this flag.
varip bool generatedThisRun = false

if barstate.islast
    clearDrawings()
    int saved = 0
    int matching = 0
    int invalid = 0
    int drawn = 0
    int errorsDrawn = 0
    int historyOmissions = 0
    int limitOmissions = 0
    for group in groups
        saved += array.size(group.entries)
        invalid += group.invalidCount
        if isAllowed(group)
            matching += array.size(group.entries)

    if supportedChart
        // Reserve the shared label budget before drawing. Visible records go first,
        // and errors go before valid entries within each visibility pass.
        array<EntryDrawing> pending = array.new<EntryDrawing>()
        int reservedLabels = 0
        for pass = 0 to 1
            for kind = 0 to 1
                for group in groups
                    if isAllowed(group)
                        array<EntryPoint> candidates = kind == 0 ? group.errors : group.entries
                        for ep in candidates
                            int barPosition = barPositionAt(ep.timestamp)
                            int candleTime = barPosition >= 0 ? array.get(barOpenTimes, barPosition) : ep.timestamp
                            bool inView = candleTime >= chart.left_visible_bar_time and candleTime <= chart.right_visible_bar_time
                            if (pass == 0 and inView) or (pass == 1 and not inView)
                                // The circle takes one label, and a caption takes another.
                                int labelCost = entryCaption(ep) == "" ? 1 : 2
                                if barPosition < 0
                                    historyOmissions += 1
                                else if reservedLabels + labelCost > MAX_LABELS
                                    limitOmissions += 1
                                else
                                    array.push(pending, EntryDrawing.new(ep, group, barPosition))
                                    reservedLabels += labelCost
        // Draw errors last, so a valid circle at the same point can't cover them.
        for layer = 0 to 1
            for drawing in pending
                bool isError = drawing.ep.problem != ""
                if (layer == 0 and not isError) or (layer == 1 and isError)
                    drawEntry(drawing)
                    if isError
                        errorsDrawn += 1
                    else
                        drawn += 1

    string generatorMessage = "Off"
    bool pickerValid = false
    if generateEntryInput
        if not supportedChart
            generatorMessage := "Use a standard time-based chart."
        else if na(pickedPriceInput) or pickedTimeInput < 0 or pickedTimeInput > MAX_TIMESTAMP
            generatorMessage := "Pick a valid price and time."
        else if barPositionAt(pickedTimeInput) < 0
            generatorMessage := "Use Reset points and pick a loaded candle."
        else
            pickerValid := true
            generatorMessage := "Ready. Copy the record from Pine Logs."
            if not generatedThisRun
                string labelTemplate = LABEL_HEAD + valueOrPlaceholder(beLevelInput) + LABEL_MIDDLE + valueOrPlaceholder(slBufferInput) + LABEL_TAIL + LABEL_LINE
                // Log \n as typed text, so the copied record pastes into a list on one line.
                string record = "\n👇\n" + formatPrice(pickedPriceInput) + "; " + str.tostring(pickedTimeInput) + "; " + DIRECTION_PLACEHOLDER + "; " + str.replace_all(labelTemplate, "\n", "\\n") + "; " + REASON_PREFIX + " ;"
                log.info(record)
                generatedThisRun := true

    string filterMessage = "Showing the selected categories"
    if not supportedChart
        filterMessage := "Use a standard time-based chart."
    else if not showMa50Input and not showMa200Input
        filterMessage := "Turn on MA50, MA200, or both."
    else if not showDayInput and not show4hInput and not show1hInput and not show15mInput
        filterMessage := "Turn on a timeframe."
    else if saved == 0 and invalid == 0
        filterMessage := "Add records to the entry lists."
    else if matching == 0
        filterMessage := "No valid entries in the selected categories."

    string diagnosticSummary = invalid > 0 ? array.get(issues, 0) : "None"
    string diagnosticDetails = array.join(issues, "\n")
    if invalid > MAX_ISSUES
        diagnosticDetails += "\nShowing the first " + str.tostring(MAX_ISSUES) + " of " + str.tostring(invalid) + " errors."
    if invalid > 1
        diagnosticSummary += "\nHover here for more errors."
    color defaultInk = chart.fg_color
    setTableRow(0, "MA Entry Circles", ticker.standard(syminfo.tickerid), defaultInk, "Records store no symbol. Use them on the market you recorded them for.")
    setTableRow(1, "Saved / matching / drawn", str.tostring(saved) + " / " + str.tostring(matching) + " / " + str.tostring(drawn), defaultInk, "Counts valid entries. The Invalid / error circles row counts invalid records.")
    setTableRow(2, "MA50 · 1D / 4h / 1h / 15m", categoryCounts(0), defaultInk)
    setTableRow(3, "MA200 · 1D / 4h / 1h / 15m", categoryCounts(4), defaultInk)
    setTableRow(4, "Not drawn · history / limits", str.tostring(historyOmissions) + " / " + str.tostring(limitOmissions), historyOmissions + limitOmissions > 0 ? color.orange : defaultInk, "Entries and placeable errors in the selected categories that the script didn't draw. History: no loaded candle contains the time, or the time falls in a session gap. Limits: the script draws at most " + str.tostring(MAX_LABELS) + " labels. Errors and entries with a label or a reason take two labels. Other entries take one. Visible records get labels first, and errors come before valid entries in each pass.")
    setTableRow(5, "Invalid / error circles", str.tostring(invalid) + " / " + str.tostring(errorsDrawn), invalid > 0 ? color.red : defaultInk, "Invalid: all malformed records. Error circles: the red circles the script drew in the selected categories. A row with an unusable price or time gets no circle; find it in Diagnostics.")
    setTableRow(6, "Filters / chart", filterMessage, supportedChart ? defaultInk : color.orange)
    setTableRow(7, "Generator", generatorMessage, generateEntryInput and not pickerValid ? color.orange : defaultInk)
    setTableRow(8, "Picked price / time (UTC)", pickerValid ? formatPrice(pickedPriceInput) + " · " + formatUtcTime(pickedTimeInput) : "None", defaultInk)
    setTableRow(9, "Diagnostics", diagnosticSummary, invalid > 0 ? color.orange : defaultInk, diagnosticDetails)
