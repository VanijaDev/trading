//@version=6
indicator("MA Entry Circles", overlay = true, format = format.price, precision = 0, max_labels_count = 500)

// QUICK TUTORIAL — MA Entry Circles
// Draws a circle centered at each saved price/time, with an optional short label.
// MA50 and MA200 are classification tags; this script does not draw moving averages.
//
// 1. Paste this file into a new TradingView Pine indicator, save, and add to chart.
//    Use a standard time-based chart for the market your entries belong to.
// 2. Add entries to the eight lists below: one per strategy/timeframe combination.
//    In Settings > Draw entries, enable the strategies and timeframe categories
//    you want to see. These filters do not change the chart's current timeframe.
// 3. In Circle appearance, choose Circle size and the shared Border and fill color.
//    Tiny starts at the former Huge size; Small / Normal / Large / X-Large / Huge
//    are progressively larger.
//    These are display-size presets, not a numerical pixel radius.
// 4. In Settings > Inputs > Tables, choose Tiny / Small / Normal / Large / Huge.
//
// RECORD FORMAT: price; UNIX timestamp in milliseconds; u/d; short label;
// Generated/displayed prices drop the fractional part: 82655.585 becomes 82655.
// Manually entered decimals remain supported; use a dot and NO thousands separators.
// Timestamps identify an absolute instant; table and tooltip dates use UTC.
// Direction places the label below (u) or above (d); the circle stays on the price.
// Labels may be empty, but cannot contain semicolons or line breaks.
//
//
//      EXAMPLE ONLY — add the quoted row to MA50_1D_ROWS below; do not duplicate the list:
//      
//          "_price_; __timestamp; _u/d_; _prifit_ (BE: when BE, dd: _max drawdown_);",
//          
//            var array<string> MA50_1D_ROWS = array.from(
//              "88123; 1786665600000; u; 5x (BE: 3x, dd: $567);",
//              ""
//          )
//
//
// Add each quoted row ABOVE the final empty string, followed by a comma.
// Blank items are ignored. Edit a row to change an entry; delete it to remove one.
// Save and update the script on the chart after editing. No examples are preloaded.
//
// PICK A POINT TO GENERATE A RECORD:
// 1. In Settings, enable Generate an ep model.
// 2. Use the indicator's More > Reset points, then pick a price/time on the chart,
//    or drag its existing point. Ordinary chart clicks do not create records.
// 3. Open Pine Logs and copy the record after the leading newline, without the log
//    timestamp prefix. Generated prices are truncated, not rounded.
// 4. Replace the first ___ with u or d, and the second with your label (or leave empty).
// 5. Wrap the record in quotes, add a comma, and paste it into the matching source
//    list as above. Save and update. Picking alone does not save a new entry.
// Reset points reselects the native input; it does not delete saved entries.
// Turn generation off when finished. Deselect the indicator to hide its input handle.
//
// CHECK / KEEP YOUR ENTRIES:
// Bottom-right statistics show saved, matching, drawn, invalid, and omitted counts.
// Incomplete/invalid rows with valid price/time draw red circles labeled !! ERROR !!!.
// Hover over an error for its source item and reason. Fix that row and update.
// Bad price/time cannot be placed on the chart; check the table's Diagnostics.
// If a circle is missing, check the filters, loaded chart history, and Diagnostics.
// Lists have no symbol field: keep separate script copies for different markets.
// Save the Pine source and a local backup; Settings does not store the entry lists.

// MANUAL ENTRY LISTS — edit these eight lists to maintain your entries.

var array<string> MA50_1D_ROWS = array.from(
    // SL: 
    // BE: 
    ""
)
var array<string> MA50_4H_ROWS = array.from(
    // SL: 
    // BE: 
    ""
)
var array<string> MA50_1H_ROWS = array.from(
    // SL: 
    // BE: 
    ""
)
var array<string> MA50_15M_ROWS = array.from(
    // SL: 
    // BE: 
    ""
)
var array<string> MA200_1D_ROWS = array.from(
    // SL: 
    // BE: 
    ""
)
var array<string> MA200_4H_ROWS = array.from(
    // SL: 
    // BE: 
    ""
)
var array<string> MA200_1H_ROWS = array.from(
    // SL: 
    // BE: 
    ""
)
var array<string> MA200_15M_ROWS = array.from(
    // SL: 
    // BE: 
    ""
)

// SETTINGS
const string FILTERS = "Draw entries"
const string STYLE = "Circle appearance"
const string TABLES = "Tables"
const string GENERATOR = "Generate an entry"
const int MAX_LABELS = 500
const int MAX_BARS = 100000
const int MAX_ISSUES = 20

bool showMa50 = input.bool(true, "MA50", inline = "strategy", group = FILTERS)
bool showMa200 = input.bool(true, "MA200", inline = "strategy", group = FILTERS)
bool showDay = input.bool(true, "1D", inline = "timeframe", group = FILTERS)
bool show4h = input.bool(true, "4h", inline = "timeframe", group = FILTERS)
bool show1h = input.bool(true, "1h", inline = "timeframe", group = FILTERS)
bool show15m = input.bool(true, "15m", inline = "timeframe", group = FILTERS, tooltip = "Select stored entry categories. These checkboxes do not change the chart timeframe.")

string circleSize = input.string("Normal", "Circle size", options = ["Tiny", "Small", "Normal", "Large", "X-Large", "Huge"], group = STYLE, tooltip = "Enlarged presets: Tiny starts at the former Huge size; each following option is larger. These are display sizes, not radii in pixels or price units.")
color circleColor = input.color(color.black, "Border and fill color", group = STYLE, tooltip = "One shared color for valid entries across both strategies and all timeframes. Invalid entries always use opaque red.")

string tableSize = input.string("Small", "Table size", options = ["Tiny", "Small", "Normal", "Large", "Huge"], group = TABLES, tooltip = "Scales all statistics text and the table cells together. Small preserves the previous table size. This control is in Inputs; the built-in Style > Tables checkbox controls visibility.")

bool generateEntry = input.bool(false, "Generate an ep model", group = GENERATOR, tooltip = "Enable, then use More > Reset points and pick a location, or drag the existing point. Copy the record from Pine Logs, fill in direction and label, and add it to a source list. Ordinary clicks do not generate records.")
float pickedPrice = input.price(0.0, "Price", inline = "point", group = GENERATOR, confirm = true)
int pickedTime = input.time(0, "Time", inline = "point", group = GENERATOR, confirm = true, tooltip = "One native time/price picker. TradingView may ask for a point when adding the indicator even if generation is off. Reset points selects a new point; it does not erase the source lists.")

type EntryPoint
    float price
    int timestamp
    string direction
    string shortLabel
    string problem = ""

type EntryGroup
    string strategy
    string sourceTimeframe
    array<EntryPoint> entries
    array<EntryPoint> errors
    int invalidCount

type EntryDrawing
    EntryPoint ep
    EntryGroup group

var array<EntryGroup> groups = array.new<EntryGroup>()
var array<string> issues = array.new<string>()
var array<int> barOpens = array.new<int>()
var array<int> barCloses = array.new<int>()
var array<label> circles = array.new<label>()
var array<label> captions = array.new<label>()
// Keep visuals on the price chart even if an existing instance occupies a pane.
var table stats = table.new(position.bottom_right, 2, 10, border_width = 1, force_overlay = true)

f_priceText(float value) =>
    // Remove the fractional part toward zero; formatting alone would round it.
    str.tostring(int(value))

// Returns the first semicolon-delimited field and the unconsumed text.
// Preserve a final token without a separator so incomplete rows can retain
// usable price/time coordinates. The parser still reports missing fields.
f_takeField(string value) =>
    int separator = str.pos(value, ";")
    bool found = not na(separator) and separator >= 0
    string field = found ? str.trim(str.substring(value, 0, separator)) : str.trim(value)
    string rest = found and separator + 1 < str.length(value) ? str.substring(value, separator + 1) : ""
    [field, rest, found]

f_parse(string raw) =>
    string row = str.trim(raw)
    [priceText, afterPrice, hasPrice] = f_takeField(row)
    [timeText, afterTime, hasTime] = f_takeField(afterPrice)
    [directionText, afterDirection, hasDirection] = f_takeField(afterTime)
    string labelText = str.trim(afterDirection)
    if str.endswith(labelText, ";")
        labelText := str.trim(str.substring(labelText, 0, str.length(labelText) - 1))
    float priceNumber = str.tonumber(priceText)
    float timeNumber = str.tonumber(timeText)
    bool validPrice = not na(priceNumber) and not str.contains(priceText, ",") and not str.contains(priceText, "\n") and not str.contains(priceText, "\r")
    bool validTime = not na(timeNumber) and not str.contains(timeText, "\n") and not str.contains(timeText, "\r") and timeNumber >= 0 and timeNumber <= 253402300799999 and timeNumber == math.floor(timeNumber)
    string direction = str.lower(directionText)
    direction := direction == "up" ? "u" : direction == "down" ? "d" : direction
    string problem = ""
    if not hasPrice or not hasTime or not hasDirection
        problem := "Expected price; timestamp; u/d; label;"
    else if str.contains(row, "\n") or str.contains(row, "\r")
        problem := "Keep each record on one line."
    else if not validPrice
        problem := "Invalid price. Use a decimal point and no thousands separators."
    else if not validTime
        problem := "Timestamp must be whole UNIX milliseconds (1970–9999)."
    else if direction != "u" and direction != "d"
        problem := "Direction must be u or d. Replace the ___ placeholder."
    else if str.contains(labelText, ";")
        problem := "Too many fields: a label cannot contain a semicolon."
    else if labelText == "___"
        problem := "Replace the label placeholder, or leave the label empty."
    EntryPoint ep = na
    // Invalid direction/text still has an exact chart location when both
    // coordinates are usable. It is never promoted into the valid entry list.
    if validPrice and validTime
        ep := EntryPoint.new(priceNumber, int(timeNumber), direction, labelText, problem)
    [ep, problem]

f_addGroup(array<string> rows, string strategy, string sourceTimeframe) =>
    array<EntryPoint> entries = array.new<EntryPoint>()
    array<EntryPoint> errors = array.new<EntryPoint>()
    int invalid = 0
    for [rowIndex, raw] in rows
        if str.length(str.trim(raw)) > 0
            [ep, problem] = f_parse(raw)
            if problem == ""
                array.push(entries, ep)
            else
                invalid += 1
                string diagnostic = strategy + " / " + sourceTimeframe + " / item " + str.tostring(rowIndex + 1) + ": " + problem
                if not na(ep)
                    ep.problem := diagnostic
                    array.push(errors, ep)
                if array.size(issues) < MAX_ISSUES
                    array.push(issues, diagnostic)
    array.push(groups, EntryGroup.new(strategy, sourceTimeframe, entries, errors, invalid))
    0

f_allowed(EntryGroup group) =>
    bool strategyAllowed = group.strategy == "MA50" ? showMa50 : showMa200
    bool timeframeAllowed = switch group.sourceTimeframe
        "1D" => showDay
        "4h" => show4h
        "1h" => show1h
        "15m" => show15m
        => false
    strategyAllowed and timeframeAllowed

f_circleSize() =>
    // Numeric label sizes allow presets beyond size.huge (equivalent to 24).
    switch circleSize
        "Tiny" => 24
        "Small" => 36
        "Large" => 60
        "X-Large" => 66
        "Huge" => 72
        => 48

f_tableSize() =>
    switch tableSize
        "Tiny" => size.tiny
        "Small" => size.small
        "Large" => size.large
        "Huge" => size.huge
        => size.normal

// Locate the candle that actually contains the timestamp, not a nearby candle
// on the opposite side of an overnight/weekend/session gap.
f_barAt(int timestampValue) =>
    int lo = 0
    int hi = array.size(barOpens) - 1
    int found = -1
    while lo <= hi
        int middle = int(math.floor((lo + hi) / 2.0))
        if array.get(barOpens, middle) <= timestampValue
            found := middle
            lo := middle + 1
        else
            hi := middle - 1
    if found >= 0
        int closing = array.get(barCloses, found)
        if na(closing) or timestampValue >= closing
            found := -1
    found

f_clearDrawings() =>
    while array.size(circles) > 0
        label.delete(array.pop(circles))
    while array.size(captions) > 0
        label.delete(array.pop(captions))
    0

f_draw(EntryPoint ep, EntryGroup group) =>
    bool isError = ep.problem != ""
    color markerColor = isError ? color.red : circleColor
    string caption = isError ? "!! ERROR !!!" : ep.shortLabel
    string heading = isError ? ep.problem : group.strategy + " · " + group.sourceTimeframe + " · " + str.upper(ep.direction)
    string details = heading + "\nPrice: " + f_priceText(ep.price) + "\n" + str.format_time(ep.timestamp, "yyyy-MM-dd HH:mm:ss", "UTC") + " UTC" + (isError or ep.shortLabel == "" ? "" : "\nLabel: " + ep.shortLabel)
    // An EMPTY native circle stays round: caption length cannot stretch it.
    // Its center is the exact recorded point, with no price/time offsets.
    array.push(circles, label.new(ep.timestamp, ep.price, "", xloc = xloc.bar_time, yloc = yloc.price, color = markerColor, style = label.style_circle, size = f_circleSize(), tooltip = details, force_overlay = true))
    if caption != ""
        // Transparent caption backgrounds keep the marker and text independent.
        // Padding uses text lines, so it does not shift the circle's anchor.
        // Retain the former Huge padding (3 lines at size 24) as the baseline.
        int paddingLines = int(math.ceil(f_circleSize() / 8.0))
        string padding = str.repeat("\n", paddingLines)
        // Errors always put their warning above the marker; no direction is guessed.
        bool isUp = not isError and ep.direction == "u"
        string captionText = isUp ? padding + caption : caption + padding
        array.push(captions, label.new(ep.timestamp, ep.price, captionText, xloc = xloc.bar_time, yloc = yloc.price, color = color.new(markerColor, 100), style = isUp ? label.style_label_up : label.style_label_down, textcolor = isError ? color.red : chart.fg_color, size = size.small, tooltip = details, force_overlay = true))
    0

f_counts(int start) =>
    string result = ""
    for i = start to start + 3
        EntryGroup group = array.get(groups, i)
        result += (i == start ? "" : " / ") + str.tostring(array.size(group.entries))
    result

f_tableRow(int row, string title, string value, color ink, string tip = "") =>
    table.cell(stats, 0, row, title, text_color = chart.fg_color, bgcolor = color.new(chart.bg_color, 5), text_size = f_tableSize(), text_halign = text.align_left)
    table.cell(stats, 1, row, value, text_color = ink, bgcolor = color.new(chart.bg_color, 5), text_size = f_tableSize(), text_halign = text.align_left, tooltip = tip)
    0

// Build all eight EP arrays once, including categories currently hidden.
if barstate.isfirst
    f_addGroup(MA50_1D_ROWS, "MA50", "1D")
    f_addGroup(MA50_4H_ROWS, "MA50", "4h")
    f_addGroup(MA50_1H_ROWS, "MA50", "1h")
    f_addGroup(MA50_15M_ROWS, "MA50", "15m")
    f_addGroup(MA200_1D_ROWS, "MA200", "1D")
    f_addGroup(MA200_4H_ROWS, "MA200", "4h")
    f_addGroup(MA200_1H_ROWS, "MA200", "1h")
    f_addGroup(MA200_15M_ROWS, "MA200", "15m")

bool supportedChart = chart.is_standard and not timeframe.isticks and not na(time_close)
if supportedChart
    int lastIndex = array.size(barOpens) - 1
    if lastIndex < 0 or array.get(barOpens, lastIndex) != time
        if array.size(barOpens) >= MAX_BARS
            array.shift(barOpens)
            array.shift(barCloses)
        array.push(barOpens, time)
        array.push(barCloses, time_close)
    else
        array.set(barCloses, lastIndex, time_close)

// varip prevents repeated logs on realtime ticks. A native picker/input change
// reloads the script, rebuilding its log history and resetting this guard.
varip bool generatedThisRun = false

if barstate.islast
    f_clearDrawings()
    int saved = 0
    int matching = 0
    int invalid = 0
    int drawn = 0
    int errorsDrawn = 0
    int historyOmissions = 0
    int limitOmissions = 0
    for group in groups
        saved += array.size(group.entries)
        invalid += group.invalidCount
        if f_allowed(group)
            matching += array.size(group.entries)

    if supportedChart
        // Reserve the shared 500-label budget before drawing. Visible records
        // take priority, with errors before valid entries within each visibility pass.
        array<EntryDrawing> pending = array.new<EntryDrawing>()
        int reservedLabels = 0
        for pass = 0 to 1
            for kind = 0 to 1
                for group in groups
                    if f_allowed(group)
                        array<EntryPoint> candidates = kind == 0 ? group.errors : group.entries
                        for ep in candidates
                            int barPosition = f_barAt(ep.timestamp)
                            int candleTime = barPosition >= 0 ? array.get(barOpens, barPosition) : ep.timestamp
                            bool inView = candleTime >= chart.left_visible_bar_time and candleTime <= chart.right_visible_bar_time
                            if (pass == 0 and inView) or (pass == 1 and not inView)
                                int labelCost = ep.problem != "" or ep.shortLabel != "" ? 2 : 1
                                if barPosition < 0
                                    historyOmissions += 1
                                else if reservedLabels + labelCost > MAX_LABELS
                                    limitOmissions += 1
                                else
                                    array.push(pending, EntryDrawing.new(ep, group))
                                    reservedLabels += labelCost
        // Draw warnings last so a valid circle at the same point cannot cover them.
        for layer = 0 to 1
            for drawing in pending
                bool isError = drawing.ep.problem != ""
                if (layer == 0 and not isError) or (layer == 1 and isError)
                    f_draw(drawing.ep, drawing.group)
                    if isError
                        errorsDrawn += 1
                    else
                        drawn += 1

    string generatorMessage = "Off"
    bool pickerValid = false
    if generateEntry
        if not supportedChart
            generatorMessage := "Use a standard time-based chart."
        else if na(pickedPrice) or pickedTime < 0 or pickedTime > 253402300799999
            generatorMessage := "Invalid picked price or timestamp."
        else if f_barAt(pickedTime) < 0
            generatorMessage := "Use Reset points; select a loaded candle."
        else
            pickerValid := true
            generatorMessage := "Ready — copy the record from Pine Logs."
            if not generatedThisRun
                string record = "\n 👉 " + f_priceText(pickedPrice) + "; " + str.tostring(pickedTime) + "; ___; ___;"
                log.info(record)
                generatedThisRun := true

    string filterMessage = "Selected source categories"
    if not supportedChart
        filterMessage := "Use standard time-based candles."
    else if not showMa50 and not showMa200
        filterMessage := "Select MA50 and/or MA200."
    else if not showDay and not show4h and not show1h and not show15m
        filterMessage := "Select at least one timeframe."
    else if saved == 0 and invalid == 0
        filterMessage := "Add records to the eight source lists."
    else if matching == 0
        filterMessage := "No valid entries in the selected categories."

    string diagnosticSummary = invalid > 0 ? array.get(issues, 0) : "None"
    string diagnosticDetails = array.join(issues, "\n")
    if invalid > MAX_ISSUES
        diagnosticDetails += "\nFirst " + str.tostring(MAX_ISSUES) + " errors shown; " + str.tostring(invalid) + " total."
    if invalid > 1
        diagnosticSummary += "\nHover here for more errors."
    color normal = chart.fg_color
    f_tableRow(0, "MA Entry Circles", ticker.standard(syminfo.tickerid), normal, "Records belong to the market for which you collected them. No symbol is stored in a record.")
    f_tableRow(1, "Saved / matching / drawn", str.tostring(saved) + " / " + str.tostring(matching) + " / " + str.tostring(drawn), normal, "Valid entries only. Invalid records and their red error circles are counted separately.")
    f_tableRow(2, "MA50 · 1D / 4h / 1h / 15m", f_counts(0), normal)
    f_tableRow(3, "MA200 · 1D / 4h / 1h / 15m", f_counts(4), normal)
    f_tableRow(4, "Not drawn · history / limits", str.tostring(historyOmissions) + " / " + str.tostring(limitOmissions), historyOmissions + limitOmissions > 0 ? color.orange : normal, "Includes valid entries and placeable errors in selected categories. History: candle is unavailable or in a session gap. Limits: 500 labels total; each error uses two. Visible records take priority, then errors within each visibility pass.")
    f_tableRow(5, "Invalid / error circles", str.tostring(invalid) + " / " + str.tostring(errorsDrawn), invalid > 0 ? color.red : normal, "Invalid counts all malformed records. Error circles count those drawn in selected categories with valid coordinates and loaded history, within drawing limits. Unusable price/time is reported only in Diagnostics.")
    f_tableRow(6, "Filters / chart", filterMessage, supportedChart ? normal : color.orange)
    f_tableRow(7, "Generator", generatorMessage, generateEntry and not pickerValid ? color.orange : normal)
    f_tableRow(8, "Picked price / time (UTC)", pickerValid ? f_priceText(pickedPrice) + " · " + str.format_time(pickedTime, "yyyy-MM-dd HH:mm:ss", "UTC") : "—", normal)
    f_tableRow(9, "Diagnostics", diagnosticSummary, invalid > 0 ? color.orange : normal, diagnosticDetails)
